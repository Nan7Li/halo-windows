<Window x:Class="Halo.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Halo.Desktop.Views"
        xmlns:c="clr-namespace:Halo.Desktop.Controls"
        Title="Halo"
        Width="1180" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FS.Body}"
        FontWeight="{DynamicResource W.Regular}"
        Foreground="{DynamicResource LabelBrush}"
        Background="{DynamicResource GroupedBrush}">
  <!-- Non-layered custom frame so DWM can draw Mica and system rounded corners. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="6"
                  UseAeroCaptionButtons="False" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <!-- ============================================================ LOGIN -->
    <Grid x:Name="LoginLayer" Background="Transparent" MouseLeftButtonDown="DragArea">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="2">
        <Button Style="{StaticResource Btn.Caption}" Click="MinClick" Content="{x:Static c:Glyphs.Minimize}" ToolTip="最小化"/>
        <Button x:Name="LoginMaxBtn" Style="{StaticResource Btn.Caption}" Click="MaxClick" Content="{x:Static c:Glyphs.Maximize}" ToolTip="最大化"/>
        <Button Style="{StaticResource Btn.CaptionClose}" Click="CloseClick" Content="{x:Static c:Glyphs.Close}" ToolTip="关闭"/>
      </StackPanel>

      <!-- 18pt dialog radius; inner group 10pt + 8pt padding keeps the corners concentric. -->
      <c:GlassPanel x:Name="LoginCard" Width="360" CornerRadius="{StaticResource D.Dialog}" Padding="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <Border Width="64" Height="64" CornerRadius="14" Margin="0,22,0,0" HorizontalAlignment="Center">
            <Border.Background>
              <ImageBrush ImageSource="pack://application:,,,/Assets/halo.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border.Background>
            <Border.Effect>
              <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.18" Color="Black"/>
            </Border.Effect>
          </Border>
          <TextBlock Text="Halo" Style="{StaticResource Text.Title2}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
          <TextBlock Text="登录到你的 Halo 实例" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,2,0,18"/>

          <c:SquircleBorder CornerRadius="{StaticResource D.Card}" Background="{DynamicResource Grouped2Brush}">
            <StackPanel>
              <Grid Height="38" Margin="12,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="64"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="地址" VerticalAlignment="Center"/>
                <TextBox x:Name="ServerBox" Grid.Column="1" Style="{StaticResource Input.Inline}" MinWidth="0"
                         c:Ui.Placeholder="http://主机:7575" KeyDown="LoginKey"/>
              </Grid>
              <c:Hairline Margin="12,0,0,0"/>
              <Grid Height="38" Margin="12,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="64"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="用户名" VerticalAlignment="Center"/>
                <TextBox x:Name="UserBox" Grid.Column="1" Style="{StaticResource Input.Inline}" MinWidth="0"
                         c:Ui.Placeholder="admin" KeyDown="LoginKey"/>
              </Grid>
              <c:Hairline Margin="12,0,0,0"/>
              <Grid Height="38" Margin="12,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="64"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="密码" VerticalAlignment="Center"/>
                <PasswordBox x:Name="PassBox" Grid.Column="1" Style="{StaticResource Input.InlinePassword}" MinWidth="0"
                             c:Ui.Placeholder="必填" KeyDown="LoginKey"/>
              </Grid>
            </StackPanel>
          </c:SquircleBorder>

          <Border x:Name="LoginError" Style="{StaticResource Banner.Error}" Margin="0,8,0,0" Visibility="Collapsed">
            <DockPanel>
              <TextBlock Text="{x:Static c:Glyphs.Error}" Style="{StaticResource Text.Glyph}" FontSize="13"
                         Foreground="{DynamicResource RedBrush}" VerticalAlignment="Top" Margin="0,2,8,0"/>
              <TextBlock x:Name="LoginErrorText" TextWrapping="Wrap"/>
            </DockPanel>
          </Border>

          <Button x:Name="LoginBtn" Content="登录" Style="{StaticResource Btn.Primary}" Height="32"
                  c:Ui.CornerRadius="{StaticResource R.Control}" Margin="0,8,0,0" Click="LoginClick" IsDefault="True"/>
          <Button Content="本地预览（不连接实例）" Style="{StaticResource Btn.Plain}" HorizontalAlignment="Center"
                  Margin="0,6,0,4" Click="PreviewClick"/>
        </StackPanel>
      </c:GlassPanel>

      <TextBlock Text="原生 WPF 客户端 · 基于 VoCat 的 Halo 接口" Style="{StaticResource Text.Tertiary}"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"/>
    </Grid>

    <!-- ============================================================ SHELL -->
    <Grid x:Name="ShellLayer" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="236"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Opaque content background; only the sidebar strip shows the window material. -->
      <Border Grid.Column="1" Background="{DynamicResource GroupedBrush}"/>

      <!-- Sidebar: floating glass panel, 220 wide, 8 from the window edges. -->
      <c:GlassPanel x:Name="Sidebar" Width="220" Margin="8" CornerRadius="{StaticResource D.Sidebar}" Padding="8"
                    MouseLeftButtonDown="DragArea">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBox x:Name="SearchBox" Style="{StaticResource Input.Search}" c:Ui.Placeholder="搜索"
                   Margin="0,2,0,10" TextChanged="SearchChanged"/>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid>
              <Border x:Name="NavIndicator" Height="28" VerticalAlignment="Top" CornerRadius="{StaticResource R.Capsule28}"
                      Background="{DynamicResource SelectionFillBrush}" IsHitTestVisible="False"/>
              <StackPanel x:Name="NavStack">
                <RadioButton x:Name="NavHome" Style="{StaticResource Nav.Item}" Content="主页" Tag="{x:Static c:Glyphs.Home}" IsChecked="True" Checked="NavChecked"/>
                <RadioButton x:Name="NavMsg" Style="{StaticResource Nav.Item}" Content="消息" Tag="{x:Static c:Glyphs.Message}" Checked="NavChecked"/>
                <RadioButton x:Name="NavPhone" Style="{StaticResource Nav.Item}" Content="电话" Tag="{x:Static c:Glyphs.Phone}" Checked="NavChecked"/>

                <TextBlock Text="设备" Style="{StaticResource Text.SectionHeader}" Margin="10,14,0,4"/>
                <RadioButton x:Name="NavDev" Style="{StaticResource Nav.Item}" Content="设备" Tag="{x:Static c:Glyphs.Device}" Checked="NavChecked"/>

                <TextBlock Text="网络与自动化" Style="{StaticResource Text.SectionHeader}" Margin="10,14,0,4"/>
                <RadioButton x:Name="NavNet" Style="{StaticResource Nav.Item}" Content="网络" Tag="{x:Static c:Glyphs.Vpn}" Checked="NavChecked"/>

                <TextBlock Text="系统" Style="{StaticResource Text.SectionHeader}" Margin="10,14,0,4"/>
                <RadioButton x:Name="NavLogs" Style="{StaticResource Nav.Item}" Content="日志" Tag="{x:Static c:Glyphs.List}" Checked="NavChecked"/>
                <RadioButton x:Name="NavSet" Style="{StaticResource Nav.Item}" Content="设置" Tag="{x:Static c:Glyphs.Settings}" Checked="NavChecked"/>
              </StackPanel>
            </Grid>
          </ScrollViewer>

          <StackPanel Grid.Row="2">
            <c:Hairline Margin="8,6,8,6"/>
            <Grid Height="40" Margin="4,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AvatarBrush}">
                <TextBlock x:Name="UserInitial" Text="H" Foreground="White" FontWeight="{DynamicResource W.Semibold}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                <TextBlock x:Name="UserName" Text="Admin" FontWeight="{DynamicResource W.Medium}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="UserRole" Text="Administrator" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button x:Name="AccountMore" Grid.Column="2" Style="{StaticResource Btn.Icon}" Content="{x:Static c:Glyphs.More}"
                      ToolTip="账户" Click="AccountMoreClick">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="设置…" Click="OpenSettings"/>
                    <Separator/>
                    <MenuItem Header="退出登录" Click="LogoutClick"/>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </Grid>
          </StackPanel>
        </Grid>
      </c:GlassPanel>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="52"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: title on the left, glass capsule button group on the right. -->
        <Grid Background="Transparent" MouseLeftButtonDown="DragArea">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Margin="16,0,12,0" VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Style="{StaticResource Text.Title}" Text="主页" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="PageSub" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <c:GlassPanel x:Name="ToolbarGroup" Grid.Column="1" CornerRadius="17" Padding="2" Height="34"
                        VerticalAlignment="Center" Margin="0,4,8,0">
            <StackPanel x:Name="ToolbarActions" Orientation="Horizontal"/>
          </c:GlassPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Style="{StaticResource Btn.Caption}" Click="MinClick" Content="{x:Static c:Glyphs.Minimize}" ToolTip="最小化"/>
            <Button x:Name="ShellMaxBtn" Style="{StaticResource Btn.Caption}" Click="MaxClick" Content="{x:Static c:Glyphs.Maximize}" ToolTip="最大化"/>
            <Button Style="{StaticResource Btn.CaptionClose}" Click="CloseClick" Content="{x:Static c:Glyphs.Close}" ToolTip="关闭"/>
          </StackPanel>
        </Grid>

        <Grid x:Name="PageHost" Grid.Row="1" ClipToBounds="True">
          <v:HomeView x:Name="HomePage"/>
          <v:MessagesView x:Name="MsgPage" Visibility="Collapsed"/>
          <v:PhoneView x:Name="PhonePage" Visibility="Collapsed"/>
          <v:DevicesView x:Name="DevPage" Visibility="Collapsed"/>
          <v:NetworkView x:Name="NetPage" Visibility="Collapsed"/>
          <v:LogsView x:Name="LogsPage" Visibility="Collapsed"/>
          <v:SettingsView x:Name="SetPage" Visibility="Collapsed"/>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
