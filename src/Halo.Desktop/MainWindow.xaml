<Window x:Class="Halo.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Halo.Desktop.Views"
        Title="Halo"
        Width="1280" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResize"
        FontFamily="{StaticResource TextFont}">
  <Window.Resources>
    <Storyboard x:Key="PageIn">
      <DoubleAnimation Storyboard.TargetName="PageHost" Storyboard.TargetProperty="Opacity"
                       From="0" To="1" Duration="0:0:0.38">
        <DoubleAnimation.EasingFunction>
          <CubicEase EasingMode="EaseOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <ThicknessAnimation Storyboard.TargetName="PageHost" Storyboard.TargetProperty="Margin"
                          From="0,18,0,0" To="0" Duration="0:0:0.42">
        <ThicknessAnimation.EasingFunction>
          <BackEase EasingMode="EaseOut" Amplitude="0.18"/>
        </ThicknessAnimation.EasingFunction>
      </ThicknessAnimation>
    </Storyboard>
    <Storyboard x:Key="LoginIn" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="HaloGlow" Storyboard.TargetProperty="Opacity"
                       From="0.35" To="0.85" Duration="0:0:2.4" AutoReverse="True">
        <DoubleAnimation.EasingFunction>
          <SineEase EasingMode="EaseInOut"/>
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
  </Window.Resources>

  <Border CornerRadius="18" BorderBrush="#33FFFFFF" BorderThickness="1" Background="#E6080A10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
    </Border.Effect>
    <Grid>
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FF07080C" Offset="0"/>
          <GradientStop Color="#FF101422" Offset="0.45"/>
          <GradientStop Color="#FF0C0F18" Offset="1"/>
        </LinearGradientBrush>
      </Grid.Background>

      <!-- Ambient orbs -->
      <Ellipse Width="520" Height="520" Margin="-180,-220,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.35" IsHitTestVisible="False">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#664D7CFF" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse Width="460" Height="460" Margin="0,0,-160,-200" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.28" IsHitTestVisible="False">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#669B4DFF" Offset="0"/>
            <GradientStop Color="#00000000" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <!-- LOGIN -->
      <Grid x:Name="LoginLayer" Panel.ZIndex="20">
        <Grid.RowDefinitions>
          <RowDefinition Height="40"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragMoveWindow">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,8,0">
            <Button Style="{StaticResource CaptionBtn}" Click="MinClick" Content="—"/>
            <Button Style="{StaticResource CaptionBtn}" Click="MaxClick" Content="▢"/>
            <Button Style="{StaticResource CloseBtn}" Click="CloseClick" Content="✕"/>
          </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
          <Grid Width="92" Height="92" HorizontalAlignment="Center" Margin="0,0,0,18">
            <Ellipse x:Name="HaloGlow" Width="92" Height="92">
              <Ellipse.Fill>
                <RadialGradientBrush>
                  <GradientStop Color="#AA64D2FF" Offset="0"/>
                  <GradientStop Color="#334D7CFF" Offset="0.55"/>
                  <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <Border Width="72" Height="72" CornerRadius="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#55FFFFFF" BorderThickness="1">
              <Border.Background>
                <ImageBrush ImageSource="pack://application:,,,/Assets/halo.png" Stretch="UniformToFill"/>
              </Border.Background>
            </Border>
          </Grid>
          <TextBlock Text="Halo" FontSize="34" FontWeight="SemiBold" FontFamily="{StaticResource UiFont}" HorizontalAlignment="Center"/>
          <TextBlock Text="模组、短信与 WiFi Calling 的桌面端" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,6,0,28"/>

          <Border Style="{StaticResource Card}" Padding="22">
            <StackPanel>
              <TextBlock Text="实例地址" Style="{StaticResource Caption}" Margin="4,0,0,6"/>
              <TextBox x:Name="ServerBox" Text="http://127.0.0.1:7575"/>
              <TextBlock Text="用户名" Style="{StaticResource Caption}" Margin="4,14,0,6"/>
              <TextBox x:Name="UserBox" Text="admin"/>
              <TextBlock Text="密码" Style="{StaticResource Caption}" Margin="4,14,0,6"/>
              <PasswordBox x:Name="PassBox"/>
              <TextBlock x:Name="LoginError" Foreground="#FFFF8A80" FontSize="12" Margin="4,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
              <Button x:Name="LoginBtn" Content="进入" Style="{StaticResource AccentBtn}" Margin="0,18,0,0" Height="42" Click="LoginClick"/>
              <Button Content="先看界面（本地预览）" Style="{StaticResource GhostBtn}" Margin="0,10,0,0" Height="40" Click="PreviewClick"/>
            </StackPanel>
          </Border>
          <TextBlock Text="原生 WPF · 不是网页套壳 · 基于 VoCat 的 Halo 接口" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
        </StackPanel>
      </Grid>

      <!-- SHELL -->
      <Grid x:Name="ShellLayer" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="44"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragMoveWindow">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
            <Border Width="22" Height="22" CornerRadius="7" BorderBrush="#44FFFFFF" BorderThickness="1">
              <Border.Background>
                <ImageBrush ImageSource="pack://application:,,,/Assets/halo.png" Stretch="UniformToFill"/>
              </Border.Background>
            </Border>
            <TextBlock Text="Halo" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="TopStatus" Grid.Column="1" Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
            <Button Style="{StaticResource CaptionBtn}" Click="MinClick" Content="—"/>
            <Button Style="{StaticResource CaptionBtn}" Click="MaxClick" Content="▢"/>
            <Button Style="{StaticResource CloseBtn}" Click="CloseClick" Content="✕"/>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Margin="12,0,8,12" Style="{StaticResource GlassBorder}" CornerRadius="24" Padding="8,12,8,12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBox x:Name="SearchBox" Margin="8,0,8,10" TextChanged="SearchChanged"/>
              <StackPanel Grid.Row="1">
                <RadioButton x:Name="NavHome" Style="{StaticResource NavBtn}" Content="今天" Tag="⌂" IsChecked="True" Checked="NavChecked" GroupName="nav"/>
                <RadioButton x:Name="NavMsg" Style="{StaticResource NavBtn}" Content="消息" Tag="✉" Checked="NavChecked" GroupName="nav"/>
                <RadioButton x:Name="NavPhone" Style="{StaticResource NavBtn}" Content="电话" Tag="☎" Checked="NavChecked" GroupName="nav"/>
                <RadioButton x:Name="NavDev" Style="{StaticResource NavBtn}" Content="模组" Tag="⬡" Checked="NavChecked" GroupName="nav"/>
                <RadioButton x:Name="NavNet" Style="{StaticResource NavBtn}" Content="链路" Tag="◈" Checked="NavChecked" GroupName="nav"/>
                <RadioButton x:Name="NavLogs" Style="{StaticResource NavBtn}" Content="现场" Tag="≡" Checked="NavChecked" GroupName="nav"/>
                <RadioButton x:Name="NavSet" Style="{StaticResource NavBtn}" Content="设置" Tag="⚙" Checked="NavChecked" GroupName="nav"/>
              </StackPanel>
              <Border Grid.Row="2" Style="{StaticResource GlassBorder}" CornerRadius="16" Padding="12" Margin="8,8,8,4" Background="#22FFFFFF">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="17" Background="#334D7CFF">
                    <TextBlock x:Name="UserInitial" Text="H" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="UserName" Text="Admin" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="UserRole" Text="Administrator" Style="{StaticResource Caption}"/>
                  </StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource GhostBtn}" Padding="8,6" Content="退出" Click="LogoutClick"/>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <Grid Grid.Column="1" Margin="0,0,14,12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="8,4,8,10">
              <TextBlock x:Name="PageTitle" Style="{StaticResource Title}" Text="今天"/>
              <TextBlock x:Name="PageSub" Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="模组、信号与出口，一眼看完"/>
            </StackPanel>
            <Border x:Name="PageHost" Grid.Row="1" Style="{StaticResource GlassBorder}" CornerRadius="24" Padding="4" Opacity="1">
              <Grid>
                <v:HomeView x:Name="HomePage"/>
                <v:MessagesView x:Name="MsgPage" Visibility="Collapsed"/>
                <v:PhoneView x:Name="PhonePage" Visibility="Collapsed"/>
                <v:DevicesView x:Name="DevPage" Visibility="Collapsed"/>
                <v:NetworkView x:Name="NetPage" Visibility="Collapsed"/>
                <v:LogsView x:Name="LogsPage" Visibility="Collapsed"/>
                <v:SettingsView x:Name="SetPage" Visibility="Collapsed"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
