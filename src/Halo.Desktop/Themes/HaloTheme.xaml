<!-- Entry point for all styles. The palette (Light.xaml / Dark.xaml) is merged separately at
     index 0 of Application.Resources and swapped at runtime by Services/ThemeManager. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <!-- Controls.xaml merges Metrics.xaml itself. -->
    <ResourceDictionary Source="Controls.xaml"/>
  </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
