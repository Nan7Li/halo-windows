<!-- Light palette: Apple system semantic colors (RGB values from the Halo web design spec).
     Swapped at runtime with Dark.xaml by Services/ThemeManager. Everything here must be
     consumed through DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="LabelColor">#FF000000</Color>
  <Color x:Key="Label2Color">#FF6E6E73</Color>
  <Color x:Key="Label3Color">#FFA0A0A6</Color>
  <Color x:Key="GroupedColor">#FFF2F2F7</Color>
  <Color x:Key="Grouped2Color">#FFFFFFFF</Color>
  <Color x:Key="Grouped3Color">#FFF2F2F7</Color>
  <Color x:Key="SeparatorColor">#FFC6C6C8</Color>
  <Color x:Key="Fill3Color">#1F767680</Color>
  <Color x:Key="BlueColor">#FF007AFF</Color>
  <Color x:Key="GreenColor">#FF34C759</Color>
  <Color x:Key="OrangeColor">#FFFF9500</Color>
  <Color x:Key="RedColor">#FFFF3B30</Color>

  <SolidColorBrush x:Key="LabelBrush" Color="#FF000000"/>
  <SolidColorBrush x:Key="Label2Brush" Color="#FF6E6E73"/>
  <SolidColorBrush x:Key="Label3Brush" Color="#FFA0A0A6"/>
  <SolidColorBrush x:Key="GroupedBrush" Color="#FFF2F2F7"/>
  <SolidColorBrush x:Key="Grouped2Brush" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="Grouped3Brush" Color="#FFF2F2F7"/>
  <SolidColorBrush x:Key="SeparatorBrush" Color="#FFC6C6C8"/>
  <SolidColorBrush x:Key="Fill3Brush" Color="#1F767680"/>
  <SolidColorBrush x:Key="BlueBrush" Color="#FF007AFF"/>
  <SolidColorBrush x:Key="GreenBrush" Color="#FF34C759"/>
  <SolidColorBrush x:Key="OrangeBrush" Color="#FFFF9500"/>
  <SolidColorBrush x:Key="RedBrush" Color="#FFFF3B30"/>

  <!-- 15% tints for notice bars (no border). -->
  <SolidColorBrush x:Key="GreenTintBrush" Color="#2634C759"/>
  <SolidColorBrush x:Key="OrangeTintBrush" Color="#26FF9500"/>
  <SolidColorBrush x:Key="RedTintBrush" Color="#26FF3B30"/>

  <!-- Interaction fills derived from label. -->
  <SolidColorBrush x:Key="HoverFillBrush" Color="#0A000000"/>
  <SolidColorBrush x:Key="SelectionFillBrush" Color="#14000000"/>
  <SolidColorBrush x:Key="SegmentThumbBrush" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="SwitchThumbBrush" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="#59000000"/>

  <!-- Contacts-style monogram. -->
  <LinearGradientBrush x:Key="AvatarBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFA5ABB8" Offset="0"/>
    <GradientStop Color="#FF858994" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="DeviceThumbBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFF5F5F7" Offset="0"/>
    <GradientStop Color="#FFE3E3E8" Offset="1"/>
  </LinearGradientBrush>
</ResourceDictionary>
