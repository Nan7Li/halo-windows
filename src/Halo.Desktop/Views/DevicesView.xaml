<UserControl x:Class="Halo.Desktop.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Halo.Desktop.Controls">
  <Grid Margin="16,4,16,16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Device list -->
    <c:SquircleBorder Style="{StaticResource Card.Group}" Padding="6" VerticalAlignment="Stretch">
      <Grid>
        <ListBox x:Name="List" SelectionChanged="Pick">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Height="44">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="28" Height="28">
                  <Border Style="{StaticResource Thumb.Small}">
                    <TextBlock Text="{x:Static c:Glyphs.Device}" Style="{StaticResource Text.Glyph}" FontSize="14" Foreground="{DynamicResource Label2Brush}"/>
                  </Border>
                  <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource Grouped2Brush}" HorizontalAlignment="Right"
                          VerticalAlignment="Bottom" Margin="0,0,-2,-2">
                    <Ellipse Style="{StaticResource StatusDot}" Width="6" Height="6"/>
                  </Border>
                </Grid>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Operator}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <c:ContentUnavailable x:Name="NoDevices" Glyph="{x:Static c:Glyphs.Device}" Title="没有设备"
                              Description="在 Halo 实例里添加模组后会出现在这里。" Visibility="Collapsed"/>
      </Grid>
    </c:SquircleBorder>

    <!-- Detail -->
    <ScrollViewer x:Name="DetailScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Detail">
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Thumb.Large}">
            <TextBlock Text="{x:Static c:Glyphs.Device}" Style="{StaticResource Text.Glyph}" FontSize="26" Foreground="{DynamicResource Label2Brush}"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="DName" Style="{StaticResource Text.Title2}" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
              <Ellipse x:Name="DDot" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock x:Name="DStatus" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <Border x:Name="HintBar" Style="{StaticResource Banner.Info}" Margin="0,0,0,12" Visibility="Collapsed">
          <TextBlock x:Name="HintText" TextWrapping="Wrap"/>
        </Border>

        <c:AdaptiveGrid MinColumnWidth="150" Spacing="10" Margin="0,0,0,20">
          <ToggleButton x:Name="TileData" Style="{StaticResource Tile.Toggle}" Tag="{x:Static c:Glyphs.Cellular}" Content="蜂窝数据"
                        c:Ui.Detail="—" IsEnabled="False" ToolTip="Halo API 暂未提供蜂窝数据开关" ToolTipService.ShowOnDisabled="True"/>
          <ToggleButton x:Name="TileWifi" Style="{StaticResource Tile.Toggle}" Tag="{x:Static c:Glyphs.Wifi}" Content="VoWiFi"
                        Click="Vowifi"/>
          <ToggleButton x:Name="TileFlight" Style="{StaticResource Tile.Toggle}" Tag="{x:Static c:Glyphs.Airplane}" Content="飞行模式"
                        Click="Flight"/>
          <Button x:Name="TileReconnect" Style="{StaticResource Tile.Action}" Tag="{x:Static c:Glyphs.Sync}" Content="重连"
                  c:Ui.Detail="重新驻网" IsEnabled="False" ToolTip="Halo API 暂未提供重连接口" ToolTipService.ShowOnDisabled="True"/>
          <Button x:Name="TileReboot" Style="{StaticResource Tile.Action}" Tag="{x:Static c:Glyphs.Power}" Content="重启"
                  c:Ui.Detail="模组" c:Ui.IsDestructive="True" Click="Reboot"/>
        </c:AdaptiveGrid>

        <c:ListSection Header="信息" Footer="IMEI 和 ICCID 默认模糊，点按显示。">
          <c:ListRow Title="运营商"><TextBlock x:Name="IOp"/></c:ListRow>
          <c:ListRow Title="号码"><TextBlock x:Name="IPhone"/></c:ListRow>
          <c:ListRow Title="网络制式"><TextBlock x:Name="IMode"/></c:ListRow>
          <c:ListRow Title="频段"><TextBlock x:Name="IBand"/></c:ListRow>
          <c:ListRow Title="信号"><TextBlock x:Name="ISig"/></c:ListRow>
          <c:ListRow Title="出口 IP"><TextBlock x:Name="IIp"/></c:ListRow>
          <c:ListRow Title="IMEI"><c:SensitiveText x:Name="IImei"/></c:ListRow>
          <c:ListRow Title="ICCID"><c:SensitiveText x:Name="IIccid"/></c:ListRow>
          <c:ListRow Title="固件"><TextBlock Text="Halo API 未提供" Foreground="{DynamicResource Label3Brush}"/></c:ListRow>
        </c:ListSection>
      </StackPanel>
    </ScrollViewer>
    <c:ContentUnavailable x:Name="NoDetail" Grid.Column="2" Glyph="{x:Static c:Glyphs.Device}" Title="没有选中的设备"
                          Description="从左侧选择一台设备查看状态和控制。" Visibility="Collapsed"/>
  </Grid>
</UserControl>
