<UserControl x:Class="Halo.Desktop.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <ListBox x:Name="List" SelectionChanged="Pick">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel>
            <DockPanel>
              <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
            </DockPanel>
            <TextBlock Text="{Binding Operator}" Style="{StaticResource MutedText}" Margin="16,2,0,0"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Detail">
        <TextBlock x:Name="DName" Style="{StaticResource Title}"/>
        <TextBlock x:Name="DOp" Style="{StaticResource MutedText}" Margin="0,4,0,16"/>
        <UniformGrid Columns="3" Margin="0,0,0,16">
          <Border Style="{StaticResource Card}" Margin="0,0,8,8"><StackPanel><TextBlock Text="信号" Style="{StaticResource Caption}"/><TextBlock x:Name="DSig" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="4,0,4,8"><StackPanel><TextBlock Text="制式" Style="{StaticResource Caption}"/><TextBlock x:Name="DMode" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="8,0,0,8"><StackPanel><TextBlock Text="出口 IP" Style="{StaticResource Caption}"/><TextBlock x:Name="DIp" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
        </UniformGrid>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="标识" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock x:Name="DImei" Style="{StaticResource MutedText}"/>
            <TextBlock x:Name="DIccid" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
            <TextBlock x:Name="DPhone" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <WrapPanel>
          <Button Style="{StaticResource GhostBtn}" Content="飞行模式" Margin="0,0,8,8" Click="Flight"/>
          <Button Style="{StaticResource GhostBtn}" Content="WiFi Calling" Margin="0,0,8,8" Click="Vowifi"/>
          <Button Style="{StaticResource DangerBtn}" Content="重启模组" Margin="0,0,8,8" Click="Reboot"/>
        </WrapPanel>
        <TextBlock x:Name="DHint" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
