<UserControl x:Class="Halo.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22">
    <StackPanel>
      <TextBlock x:Name="Hello" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"/>
      <TextBlock x:Name="HelloSub" Style="{StaticResource MutedText}" Margin="0,4,0,18"/>

      <UniformGrid Columns="4" Margin="0,0,0,16">
        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
          <StackPanel>
            <TextBlock Text="在线模组" Style="{StaticResource Caption}"/>
            <TextBlock x:Name="OnlineText" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <TextBlock x:Name="OnlineSub" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="4,0">
          <StackPanel>
            <TextBlock Text="CPU" Style="{StaticResource Caption}"/>
            <TextBlock x:Name="CpuText" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <ProgressBar x:Name="CpuBar" Height="6" Minimum="0" Maximum="100" Margin="0,10,0,0" Foreground="{StaticResource AccentBrush}" Background="#22FFFFFF" BorderThickness="0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="4,0">
          <StackPanel>
            <TextBlock Text="内存" Style="{StaticResource Caption}"/>
            <TextBlock x:Name="MemText" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <TextBlock x:Name="MemSub" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="8,0,0,0">
          <StackPanel>
            <TextBlock Text="网络" Style="{StaticResource Caption}"/>
            <TextBlock x:Name="NetText" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="BoardText" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
      </UniformGrid>

      <TextBlock Text="模组" FontWeight="SemiBold" FontSize="15" Margin="4,4,0,10"/>
      <ItemsControl x:Name="DeviceList">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Width="280" Margin="0,0,12,12" Cursor="Hand">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="14" Background="#3328C4F0" VerticalAlignment="Top">
                  <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                  <DockPanel>
                    <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  </DockPanel>
                  <TextBlock Text="{Binding Operator}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                  <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}">
                    <Run Text="{Binding Mode}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding SignalText}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding PublicIp}"/>
                  </TextBlock>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="接下来" FontWeight="SemiBold" FontSize="15" Margin="4,8,0,10"/>
      <ItemsControl x:Name="TaskList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource GlassBorder}" CornerRadius="14" Padding="14,10" Margin="0,0,0,8">
              <DockPanel>
                <TextBlock Text="{Binding Next}" Style="{StaticResource Caption}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
