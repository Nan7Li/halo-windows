<UserControl x:Class="Halo.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Halo.Desktop.Controls">
  <UserControl.Resources>
    <!-- Widget title: small coloured symbol + 11pt label2 caption. -->
    <Style x:Key="WidgetGlyph" TargetType="TextBlock" BasedOn="{StaticResource Text.Glyph}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,4,16,16">
    <StackPanel>
      <Border x:Name="PreviewBanner" Style="{StaticResource Banner.Info}" Margin="0,0,0,12" Visibility="Collapsed">
        <DockPanel>
          <TextBlock Text="{x:Static c:Glyphs.Info}" Style="{StaticResource Text.Glyph}" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
          <TextBlock Text="本地预览：这里是示例数据，操作不会发到任何实例。" TextWrapping="Wrap"/>
        </DockPanel>
      </Border>

      <c:AdaptiveGrid MinColumnWidth="220" Spacing="12">

        <!-- Lines online -->
        <c:SquircleBorder Style="{StaticResource Card.Group}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{x:Static c:Glyphs.Cellular}" Style="{StaticResource WidgetGlyph}" Foreground="{DynamicResource GreenBrush}"/>
              <TextBlock Text="线路在线" Style="{StaticResource Text.Caption}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
              <TextBlock x:Name="OnlineText" Style="{StaticResource Text.Large}" Text="0"/>
              <TextBlock x:Name="OnlineTotal" Style="{StaticResource Text.Secondary}" FontSize="{StaticResource FS.Title3}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
            </StackPanel>
            <ItemsControl x:Name="DeviceList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding Mode}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </c:SquircleBorder>

        <!-- Network rate -->
        <c:SquircleBorder Style="{StaticResource Card.Group}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{x:Static c:Glyphs.Speed}" Style="{StaticResource WidgetGlyph}" Foreground="{DynamicResource AccentBrush}"/>
              <TextBlock Text="网络速率" Style="{StaticResource Text.Caption}"/>
            </StackPanel>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="下行" Style="{StaticResource Text.Caption}"/>
                <TextBlock x:Name="RxText" Style="{StaticResource Text.Title2}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="上行" Style="{StaticResource Text.Caption}"/>
                <TextBlock x:Name="TxText" Style="{StaticResource Text.Title2}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="BoardText" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </c:SquircleBorder>

        <!-- Upcoming tasks -->
        <c:SquircleBorder Style="{StaticResource Card.Group}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{x:Static c:Glyphs.Clock}" Style="{StaticResource WidgetGlyph}" Foreground="{DynamicResource OrangeBrush}"/>
              <TextBlock Text="即将执行" Style="{StaticResource Text.Caption}"/>
            </StackPanel>
            <ItemsControl x:Name="TaskList" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding Next}" Style="{StaticResource Text.Secondary}" Margin="8,0,0,0"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoTasks" Text="没有排队的任务" Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </c:SquircleBorder>

        <!-- Host: CPU / memory / disk rings -->
        <c:SquircleBorder Style="{StaticResource Card.Group}" c:AdaptiveGrid.ColumnSpan="2">
          <StackPanel>
            <DockPanel>
              <TextBlock x:Name="CpuModel" DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{x:Static c:Glyphs.Diagnostic}" Style="{StaticResource WidgetGlyph}" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="主机" Style="{StaticResource Text.Caption}"/>
              </StackPanel>
            </DockPanel>
            <UniformGrid Columns="3" Margin="0,12,0,0">
              <StackPanel HorizontalAlignment="Center">
                <Grid Width="72" Height="72">
                  <c:RingGauge x:Name="CpuRing" Thickness="7"/>
                  <TextBlock x:Name="CpuText" Style="{StaticResource Text.Headline}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="CPU" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
              </StackPanel>
              <StackPanel HorizontalAlignment="Center">
                <Grid Width="72" Height="72">
                  <c:RingGauge x:Name="MemRing" Thickness="7" Stroke="{DynamicResource GreenBrush}"/>
                  <TextBlock x:Name="MemText" Style="{StaticResource Text.Headline}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="MemSub" Text="内存" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <StackPanel HorizontalAlignment="Center">
                <Grid Width="72" Height="72">
                  <c:RingGauge x:Name="DiskRing" Thickness="7" Stroke="{DynamicResource OrangeBrush}"/>
                  <TextBlock x:Name="DiskText" Style="{StaticResource Text.Headline}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="磁盘" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
              </StackPanel>
            </UniformGrid>
          </StackPanel>
        </c:SquircleBorder>

        <!-- Recent calls -->
        <c:SquircleBorder Style="{StaticResource Card.Group}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{x:Static c:Glyphs.Phone}" Style="{StaticResource WidgetGlyph}" Foreground="{DynamicResource GreenBrush}"/>
              <TextBlock Text="最近通话" Style="{StaticResource Text.Caption}"/>
            </StackPanel>
            <ItemsControl x:Name="CallList" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Converter={StaticResource CallGlyph}}" Style="{StaticResource Text.Glyph}" FontSize="11"
                               Foreground="{DynamicResource Label3Brush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="num" Grid.Column="1" Text="{Binding Number}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding When}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Converter={StaticResource IsMissed}}" Value="True">
                      <Setter TargetName="num" Property="Foreground" Value="{DynamicResource RedBrush}"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoCalls" Text="还没有通话记录" Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </c:SquircleBorder>

        <!-- Recent messages -->
        <c:SquircleBorder Style="{StaticResource Card.Group}" c:AdaptiveGrid.ColumnSpan="3">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{x:Static c:Glyphs.Message}" Style="{StaticResource WidgetGlyph}" Foreground="{DynamicResource AccentBrush}"/>
              <TextBlock Text="最近信息" Style="{StaticResource Text.Caption}"/>
            </StackPanel>
            <ItemsControl x:Name="ThreadList" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Avatar}" Width="28" Height="28" CornerRadius="14">
                      <TextBlock Text="{Binding Avatar, Mode=OneWay}" Foreground="White" FontSize="{StaticResource FS.Caption}"
                                 FontWeight="{DynamicResource W.Semibold}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Display}" FontWeight="{DynamicResource W.Medium}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Preview}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding When}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"/>
                      <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"
                               Visibility="{Binding HasUnread, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoThreads" Text="还没有短信" Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </c:SquircleBorder>
      </c:AdaptiveGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
