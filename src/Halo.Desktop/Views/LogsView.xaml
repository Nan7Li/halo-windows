<UserControl x:Class="Halo.Desktop.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10">
      <TextBox x:Name="FilterBox" Width="240" DockPanel.Dock="Right" TextChanged="Filter"/>
      <TextBlock Text="主机事件" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
    </DockPanel>
    <Border Grid.Row="1" CornerRadius="18" Background="#CC07080C" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="12">
      <ListBox x:Name="LogList" FontFamily="{StaticResource MonoFont}" FontSize="12">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock TextWrapping="Wrap" Margin="0,2">
              <Run Text="[" Foreground="#FF8B93A7"/>
              <Run Text="{Binding Time}" Foreground="#FF8B93A7"/>
              <Run Text="] " Foreground="#FF8B93A7"/>
              <Run Text="{Binding Level}" Foreground="{Binding LevelBrush}" FontWeight="Bold"/>
              <Run Text="  "/>
              <Run Text="{Binding Message}"/>
            </TextBlock>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</UserControl>
