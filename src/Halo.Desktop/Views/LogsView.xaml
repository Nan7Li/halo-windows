<UserControl x:Class="Halo.Desktop.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Halo.Desktop.Controls">
  <Grid Margin="16,4,16,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <c:SegmentedControl x:Name="LevelPick" DockPanel.Dock="Right" Width="260" Margin="12,0,0,0" SelectionChanged="LevelChanged">
        <ListBoxItem Content="全部"/>
        <ListBoxItem Content="信息"/>
        <ListBoxItem Content="警告"/>
        <ListBoxItem Content="错误"/>
      </c:SegmentedControl>
      <TextBox x:Name="FilterBox" Style="{StaticResource Input.Search}" c:Ui.Placeholder="搜索日志" MaxWidth="320"
               HorizontalAlignment="Left" MinWidth="200" TextChanged="Filter"/>
    </DockPanel>

    <c:SquircleBorder Grid.Row="1" Style="{StaticResource Card.Group}" Padding="0,6">
      <Grid>
        <ListBox x:Name="LogList" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FS.Mono}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ItemContainerStyle="{StaticResource ListItem.Flush}">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="复制" c:Ui.Glyph="{x:Static c:Glyphs.Copy}" Click="CopyLine"/>
              <MenuItem Header="复制全部可见日志" Click="CopyAll"/>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="14,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="58"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Label3Brush}" Margin="0,0,12,0"/>
                <TextBlock x:Name="lvl" Grid.Column="1" Text="{Binding Level, Converter={StaticResource Upper}}"
                           Foreground="{DynamicResource Label2Brush}"/>
                <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"/>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level, Converter={StaticResource LogKind}}" Value="error">
                  <Setter TargetName="lvl" Property="Foreground" Value="{DynamicResource RedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level, Converter={StaticResource LogKind}}" Value="warn">
                  <Setter TargetName="lvl" Property="Foreground" Value="{DynamicResource OrangeBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level, Converter={StaticResource LogKind}}" Value="debug">
                  <Setter TargetName="lvl" Property="Foreground" Value="{DynamicResource Label3Brush}"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <c:ContentUnavailable x:Name="Empty" Glyph="{x:Static c:Glyphs.List}" Title="没有日志" Visibility="Collapsed"/>
      </Grid>
    </c:SquircleBorder>
  </Grid>
</UserControl>
