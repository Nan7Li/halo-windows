<UserControl x:Class="Halo.Desktop.Views.MessagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Halo.Desktop.Controls">
  <UserControl.Resources>
    <ContextMenu x:Key="ThreadMenu" x:Shared="False">
      <MenuItem Header="标记为已读" Click="MarkRead"/>
      <MenuItem Header="复制号码" c:Ui.Glyph="{x:Static c:Glyphs.Copy}" Click="CopyNumber"/>
    </ContextMenu>
  </UserControl.Resources>
  <Grid Margin="16,4,16,16">
    <c:SquircleBorder Style="{StaticResource Card.Group}" Padding="0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="280"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Conversation list -->
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBox x:Name="FilterBox" Style="{StaticResource Input.Search}" c:Ui.Placeholder="搜索" Margin="12,12,12,8"
                   TextChanged="FilterChanged"/>
          <ListBox x:Name="ThreadList" Grid.Row="1" Padding="6,0,6,6" SelectionChanged="ThreadPicked">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Height="58" Margin="-4,0,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Visibility="{Binding HasUnread, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                  <Border Grid.Column="1" Style="{StaticResource Avatar}">
                    <TextBlock Text="{Binding Avatar, Mode=OneWay}" Foreground="White" FontWeight="{DynamicResource W.Semibold}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="2" Margin="10,0,4,0" VerticalAlignment="Center">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Display}" Style="{StaticResource Text.Headline}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Preview}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="ContextMenu" Value="{StaticResource ThreadMenu}"/>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
          <c:ContentUnavailable x:Name="NoThreads" Grid.Row="1" Glyph="{x:Static c:Glyphs.Chat}" Title="没有信息"
                                Description="收到的短信会出现在这里。" Visibility="Collapsed"/>
        </Grid>

        <c:Hairline Grid.Column="1" Vertical="True"/>

        <!-- Conversation -->
        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel x:Name="PeerHeader" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0">
            <TextBlock x:Name="PeerTitle" Style="{StaticResource Text.Headline}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="PeerSub" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <c:Hairline x:Name="PeerLine" Grid.Row="1"/>

          <ScrollViewer x:Name="ChatScroll" Grid.Row="2" Padding="16,12" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="BubbleList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,8" HorizontalAlignment="{Binding Align, Mode=OneWay}">
                    <Border x:Name="bubble" MaxWidth="420" CornerRadius="18" Padding="12,7" Background="{DynamicResource Fill3Brush}"
                            HorizontalAlignment="{Binding Align, Mode=OneWay}">
                      <TextBlock x:Name="body" Text="{Binding Body}" TextWrapping="Wrap"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="6,3,6,0" HorizontalAlignment="{Binding Align, Mode=OneWay}">
                      <TextBlock Text="{Binding Time}" Style="{StaticResource Text.Tertiary}"/>
                      <TextBlock x:Name="status" Text="{Binding Status, StringFormat=' · {0}'}" Style="{StaticResource Text.Tertiary}" Visibility="Collapsed"/>
                    </StackPanel>
                  </StackPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Mine}" Value="True">
                      <Setter TargetName="bubble" Property="Background" Value="{DynamicResource AccentBrush}"/>
                      <Setter TargetName="body" Property="Foreground" Value="White"/>
                      <Setter TargetName="status" Property="Visibility" Value="{Binding Status, Converter={StaticResource EmptyToCollapsed}}"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <c:ContentUnavailable x:Name="NoSelection" Grid.Row="0" Grid.RowSpan="4" Glyph="{x:Static c:Glyphs.Message}"
                                Title="没有选中的会话" Description="从左侧选择一个会话，或在工具栏里新建信息。"/>

          <Grid x:Name="ComposerRow" Grid.Row="3" Margin="12,4,12,12">
            <TextBox x:Name="Composer" Style="{StaticResource Input.Composer}" c:Ui.Placeholder="短信" AcceptsReturn="True"
                     PreviewKeyDown="ComposerKey" VerticalScrollBarVisibility="Auto"/>
            <Button x:Name="SendBtn" Style="{StaticResource Btn.Primary}" Width="24" Height="24" Padding="0" c:Ui.CornerRadius="12"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" ToolTip="发送 (Enter)"
                    FontFamily="{StaticResource IconFont}" FontSize="11" Content="{x:Static c:Glyphs.Up}" Click="SendClick"/>
          </Grid>
        </Grid>
      </Grid>
    </c:SquircleBorder>
  </Grid>
</UserControl>
