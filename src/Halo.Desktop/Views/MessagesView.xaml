<UserControl x:Class="Halo.Desktop.Views.MessagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0" Padding="10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="6,4,6,10">
          <Button DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" Padding="12,8" Content="新短信" Click="NewSms"/>
          <TextBlock Text="会话" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox x:Name="ThreadList" Grid.Row="1" SelectionChanged="ThreadPicked">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="18" Background="#3330D158">
                  <TextBlock Text="{Binding Avatar}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0">
                  <TextBlock Text="{Binding Display}" FontWeight="SemiBold" FontSize="13"/>
                  <TextBlock Text="{Binding Preview}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding When}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                  <Border Background="#FF64D2FF" CornerRadius="8" Padding="6,1" Margin="0,6,0,0" HorizontalAlignment="Right">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasUnread}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Unread}" Foreground="#FF081018" FontSize="10" FontWeight="Bold"/>
                  </Border>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="56"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel Margin="18,8,18,0">
        <TextBlock x:Name="PeerTitle" Text="选择一个会话" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
        <TextBlock x:Name="PeerSub" Style="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </DockPanel>
      <ScrollViewer x:Name="ChatScroll" Grid.Row="1" Padding="18,8" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="BubbleList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,0,0,10" LastChildFill="False">
                <Border MaxWidth="420" CornerRadius="18" Padding="12,9" HorizontalAlignment="{Binding Align}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="#22FFFFFF"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Mine}" Value="True">
                          <Setter Property="Background" Value="#FF64D2FF"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Mine}" Value="True">
                              <Setter Property="Foreground" Value="#FF081018"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Time}" FontSize="10" Opacity="0.7" Margin="0,4,0,0"/>
                  </StackPanel>
                </Border>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Border Grid.Row="2" Margin="14" Style="{StaticResource GlassBorder}" CornerRadius="22" Padding="8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource AccentBtn}" Width="72" Height="38" Content="发送" Click="SendClick" Margin="8,0,0,0"/>
          <TextBox x:Name="Composer" KeyDown="ComposerKey"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
