<UserControl x:Class="Halo.Desktop.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Halo.Desktop.Controls">
  <UserControl.Resources>
    <!-- One menu for both the "…" button and right-click on the row. -->
    <ContextMenu x:Key="TunnelMenu" x:Shared="False">
      <MenuItem Header="修改…" c:Ui.Glyph="{x:Static c:Glyphs.Compose}" Click="EditTunnel"/>
      <Separator/>
      <MenuItem Header="删除隧道" c:Ui.Glyph="{x:Static c:Glyphs.Delete}" c:Ui.IsDestructive="True" Click="DeleteTunnel"/>
    </ContextMenu>
  </UserControl.Resources>

  <Grid>
    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Padding="16,4,16,16">
      <StackPanel MaxWidth="720" HorizontalAlignment="Stretch">
        <Border x:Name="HintBar" Style="{StaticResource Banner.Warning}" Margin="0,0,0,12" Visibility="Collapsed">
          <DockPanel>
            <TextBlock Text="{x:Static c:Glyphs.Warning}" Style="{StaticResource Text.Glyph}" FontSize="13"
                       Foreground="{DynamicResource OrangeBrush}" VerticalAlignment="Top" Margin="0,2,8,0"/>
            <TextBlock x:Name="HintText" TextWrapping="Wrap"/>
          </DockPanel>
        </Border>

        <c:ListSection x:Name="Tunnels" Header="WireGuard"
                       Footer="隧道运行在 Halo 主机上。当前的 Halo API 只提供状态读取，启停、修改和删除需要在主机上操作。">
          <c:ListSection.ItemTemplate>
            <DataTemplate>
              <c:ListRow Title="{Binding Name}" Subtitle="{Binding Endpoint}" Glyph="{x:Static c:Glyphs.Vpn}"
                         GlyphBackground="{DynamicResource BlueBrush}" ContextMenu="{StaticResource TunnelMenu}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Status, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <c:IosSwitch IsChecked="{Binding Running, Mode=OneWay}" Click="ToggleTunnel"
                               ToolTip="启停需要在 Halo 主机上操作"/>
                  <Button Style="{StaticResource Btn.Icon}" Content="{x:Static c:Glyphs.More}" Margin="6,0,-6,0" ToolTip="更多"
                          Click="MoreClick" ContextMenu="{StaticResource TunnelMenu}"/>
                </StackPanel>
              </c:ListRow>
            </DataTemplate>
          </c:ListSection.ItemTemplate>
        </c:ListSection>
      </StackPanel>
    </ScrollViewer>
    <c:ContentUnavailable x:Name="Empty" Glyph="{x:Static c:Glyphs.Vpn}" Title="没有 WireGuard 隧道"
                          Description="在 Halo 主机上添加隧道后，会出现在这里。" Visibility="Collapsed"/>
  </Grid>
</UserControl>
