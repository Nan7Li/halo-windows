<UserControl x:Class="Halo.Desktop.Views.PhoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Halo.Desktop.Controls">
  <UserControl.Resources>
    <!-- Dial key: digit with letters underneath, iOS style. -->
    <Style x:Key="Key" TargetType="Button" BasedOn="{StaticResource Btn.Dial}">
      <Setter Property="Margin" Value="6"/>
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="{StaticResource DisplayFont}"
                         FontSize="28" HorizontalAlignment="Center" LineHeight="30" LineStackingStrategy="BlockLineHeight"/>
              <TextBlock Text="{Binding}" FontSize="{StaticResource FS.Caption}" FontWeight="{DynamicResource W.Semibold}"
                         HorizontalAlignment="Center" Foreground="{DynamicResource Label2Brush}"/>
            </StackPanel>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="16,4,16,16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="300"/>
    </Grid.ColumnDefinitions>

    <!-- Recents -->
    <Grid>
      <ScrollViewer x:Name="RecentsScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border x:Name="CallBanner" Style="{StaticResource Banner.Info}" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock x:Name="CallBannerText" TextWrapping="Wrap"/>
          </Border>
          <c:ListSection x:Name="CallList" Header="最近通话" Footer="点按一行即可回拨。">
            <c:ListSection.ItemTemplate>
              <DataTemplate>
                <c:ListRow x:Name="row" Title="{Binding Number}" Subtitle="{Binding Converter={StaticResource CallDesc}}"
                           IsClickable="True" Click="RowClick" ToolTip="回拨" Content="{Binding When}">
                  <c:ListRow.Leading>
                    <TextBlock Text="{Binding Converter={StaticResource CallGlyph}}" Style="{StaticResource Text.Glyph}" FontSize="12"
                               Width="16" Foreground="{DynamicResource Label3Brush}"/>
                  </c:ListRow.Leading>
                </c:ListRow>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Converter={StaticResource IsMissed}}" Value="True">
                    <Setter TargetName="row" Property="IsDestructive" Value="True"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </c:ListSection.ItemTemplate>
          </c:ListSection>
        </StackPanel>
      </ScrollViewer>
      <c:ContentUnavailable x:Name="NoCalls" Glyph="{x:Static c:Glyphs.Phone}" Title="没有最近通话"
                            Description="通过 WiFi Calling 或蜂窝拨出、接听的电话会显示在这里。" Visibility="Collapsed"/>
    </Grid>

    <!-- Dial pad -->
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0" Margin="0,0,-10,0">
      <c:SquircleBorder Style="{StaticResource Card.Group}" Padding="14,14,14,10">
        <StackPanel>
          <ComboBox x:Name="DevicePick" SelectionChanged="DeviceChanged"/>
          <StackPanel Orientation="Horizontal" Margin="4,8,0,0">
            <Ellipse x:Name="ImsDot" Width="7" Height="7" Fill="{DynamicResource Label3Brush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock x:Name="ImsHint" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <TextBlock x:Name="NumberFace" FontFamily="{StaticResource DisplayFont}" FontSize="26" Height="40" Margin="0,12,0,4"
                     HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <UniformGrid Columns="3" HorizontalAlignment="Center">
            <Button Style="{StaticResource Key}" Tag="1" Content=" " Click="Pad"/>
            <Button Style="{StaticResource Key}" Tag="2" Content="ABC" Click="Pad"/>
            <Button Style="{StaticResource Key}" Tag="3" Content="DEF" Click="Pad"/>
            <Button Style="{StaticResource Key}" Tag="4" Content="GHI" Click="Pad"/>
            <Button Style="{StaticResource Key}" Tag="5" Content="JKL" Click="Pad"/>
            <Button Style="{StaticResource Key}" Tag="6" Content="MNO" Click="Pad"/>
            <Button Style="{StaticResource Key}" Tag="7" Content="PQRS" Click="Pad"/>
            <Button Style="{StaticResource Key}" Tag="8" Content="TUV" Click="Pad"/>
            <Button Style="{StaticResource Key}" Tag="9" Content="WXYZ" Click="Pad"/>
            <Button Style="{StaticResource Key}" Tag="*" Content=" " Click="Pad"/>
            <Button Style="{StaticResource Key}" Tag="0" Content="+" Click="Pad" MouseRightButtonUp="PadPlus" ToolTip="右键输入 +"/>
            <Button Style="{StaticResource Key}" Tag="#" Content=" " Click="Pad"/>
            <Border Width="72" Height="72" Margin="6"/>
            <Button Style="{StaticResource Btn.Call}" Margin="6" Content="{x:Static c:Glyphs.Phone}" ToolTip="呼叫" Click="CallClick"/>
            <Button x:Name="BackBtn" Style="{StaticResource Btn.Icon}" Width="72" Height="72" c:Ui.CornerRadius="36" FontSize="20" Margin="6"
                    Content="{x:Static c:Glyphs.Backspace}" ToolTip="删除" Click="Backspace"/>
          </UniformGrid>
        </StackPanel>
      </c:SquircleBorder>
    </ScrollViewer>
  </Grid>
</UserControl>
