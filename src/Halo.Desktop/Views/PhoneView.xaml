<UserControl x:Class="Halo.Desktop.Views.PhoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="340"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Style="{StaticResource Card}" Margin="0,0,16,0">
      <StackPanel>
        <TextBlock Text="拨号" FontWeight="SemiBold" FontSize="15"/>
        <ComboBox x:Name="DevicePick" Margin="0,12,0,0" Height="36"/>
        <TextBlock x:Name="ImsHint" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
        <TextBlock x:Name="NumberFace" FontSize="28" FontWeight="SemiBold" FontFamily="{StaticResource UiFont}"
                   HorizontalAlignment="Center" Margin="0,22,0,16" Text=""/>
        <UniformGrid Columns="3" Rows="4">
          <Button Style="{StaticResource GhostBtn}" Margin="6" Height="52" FontSize="20" Content="1" Click="Pad"/>
          <Button Style="{StaticResource GhostBtn}" Margin="6" Height="52" FontSize="20" Content="2" Click="Pad"/>
          <Button Style="{StaticResource GhostBtn}" Margin="6" Height="52" FontSize="20" Content="3" Click="Pad"/>
          <Button Style="{StaticResource GhostBtn}" Margin="6" Height="52" FontSize="20" Content="4" Click="Pad"/>
          <Button Style="{StaticResource GhostBtn}" Margin="6" Height="52" FontSize="20" Content="5" Click="Pad"/>
          <Button Style="{StaticResource GhostBtn}" Margin="6" Height="52" FontSize="20" Content="6" Click="Pad"/>
          <Button Style="{StaticResource GhostBtn}" Margin="6" Height="52" FontSize="20" Content="7" Click="Pad"/>
          <Button Style="{StaticResource GhostBtn}" Margin="6" Height="52" FontSize="20" Content="8" Click="Pad"/>
          <Button Style="{StaticResource GhostBtn}" Margin="6" Height="52" FontSize="20" Content="9" Click="Pad"/>
          <Button Style="{StaticResource GhostBtn}" Margin="6" Height="52" FontSize="20" Content="*" Click="Pad"/>
          <Button Style="{StaticResource GhostBtn}" Margin="6" Height="52" FontSize="20" Content="0" Click="Pad"/>
          <Button Style="{StaticResource GhostBtn}" Margin="6" Height="52" FontSize="20" Content="#" Click="Pad"/>
        </UniformGrid>
        <DockPanel Margin="6,10,6,0">
          <Button DockPanel.Dock="Left" Style="{StaticResource GhostBtn}" Content="删除" Click="Backspace"/>
          <Button Style="{StaticResource AccentBtn}" Height="44" Content="呼叫" Click="CallClick" Margin="8,0,0,0"/>
        </DockPanel>
      </StackPanel>
    </Border>

    <Border Grid.Column="1" Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="最近通话" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
        <ListBox x:Name="CallList" Grid.Row="1">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <TextBlock Text="{Binding Glyph}" FontSize="16" Width="28" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostBtn}" Padding="10,6" Content="回拨" Tag="{Binding Number}" Click="Redial"/>
                <StackPanel Margin="8,0">
                  <TextBlock Text="{Binding Number}" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource MutedText}">
                    <Run Text="{Binding When}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding State}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding Duration}"/>
                  </TextBlock>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>
